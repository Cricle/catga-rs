-            .chunks_exact(8)
-            .map(|chunk| u64::from_le_bytes(chunk.try_into().expect("chunks_exact yields 8 bytes")))
-            .collect();
-        *self.values.lock().expect("applied sequence poisoned") = restored;
-        Ok(())
-    }
-}
