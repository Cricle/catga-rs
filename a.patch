+    }
+
+    transport
+        .broadcast(Bytes::from_static(b"heartbeat"))
+        .await
+        .unwrap();
+
+    assert_eq!(
+        transport.records(),
+        vec![
+            SentRecord { peer_id: 2, payload: b"heartbeat".to_vec() },
