-            return Ok(metadata.term);
-        }
-        if index < self.first_index()? {
-            return Err(Error::Store(StorageError::Compacted));
-        }
-        if index > self.last_index()? {
-            return Err(Error::Store(StorageError::Unavailable));
-        }
