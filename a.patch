-            if !retryable {
-                return Err(error::status_to_catga(&status));
-            }
-            tokio::time::sleep(
-                MEMBERSHIP_RETRY_INTERVAL
-                    .min(deadline.saturating_duration_since(std::time::Instant::now())),
-            )
-            .await;
-        }
-    }
